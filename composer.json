{
    "name": "sidewaysnyc/sw-classic-ig",
    "description": "Sideways Instagram plugin",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "janu-software/facebook-php-sdk": "^0.4.1",
        "php-http/guzzle7-adapter": "^1.1",
        "thecodingmachine/safe": "^3.4"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "SwIgPlugin\\": "lib/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": [
            "php tests/sdk-compatibility.php",
            "php tests/login-callback.php"
        ]
    }
}
